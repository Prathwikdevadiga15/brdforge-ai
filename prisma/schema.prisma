generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(cuid())
  name        String
  domain      String
  owner       String
  status      String
  health      Int
  lastUpdated DateTime     @default(now())
  requirements Requirement[]
  conflicts   Conflict[]
  evidence    Evidence[]
  sources     Source[]
  versions    Version[]
  impact      Impact[]
  brdSections BrdSection[]
  ecoMetrics  EcoMetric[]
  ecoEvents   EcoEvent[]
  processingMetrics ProcessingMetric[]
  processingJobs ProcessingJob[]
  stakeholderDecisions StakeholderDecision[]
  scopeChanges ScopeChange[]
  documentComparisons DocumentComparison[]
  graphNodes KnowledgeGraphNode[]
  notifications Notification[]
  auditEvents  AuditEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Requirement {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  category    String
  owner       String
  status      String
  confidence  Float
  summary     String
  rationale   String
  evidenceIds String[]
  evidence    Evidence[]
  risks       RequirementRisk[]
  qualities   RequirementQuality[]
  acceptanceCriteria AcceptanceCriteria[]
  testCases   TestCase[]
  project     Project  @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
}

model Conflict {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  severity    String
  summary     String
  requirements String[]
  resolution  String
  project     Project  @relation(fields: [projectId], references: [id])
}

model Evidence {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String
  source      String
  confidence  Float
  excerpt     String
  uploadedSourceId String?
  requirementId String?
  project     Project  @relation(fields: [projectId], references: [id])
  uploadedSource Source? @relation(fields: [uploadedSourceId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])

  @@index([projectId])
  @@index([requirementId])
  @@index([uploadedSourceId])
}

model Source {
  id          String     @id @default(cuid())
  projectId   String
  filename    String
  mimeType    String
  type        String
  status      String     @default("processed")
  extractedText String   @db.Text
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence    Evidence[]

  @@index([projectId, createdAt])
}

model BrdSection {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  content     String   @db.Text
  position    Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
}

model Version {
  id          String   @id @default(cuid())
  projectId   String
  label       String
  summary     String
  timestamp   DateTime @default(now())
  impact      String
  project     Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, timestamp])
}

model Impact {
  id          String   @id @default(cuid())
  projectId   String
  section     String
  effect      String
  risk        String
  owner       String
  project     Project  @relation(fields: [projectId], references: [id])
}

model EcoMetric {
  id          String   @id @default(cuid())
  projectId   String
  score       Int
  efficiency  Int
  estimatedSavingsPercent Int
  assumptions Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model EcoEvent {
  id          String   @id @default(cuid())
  projectId   String
  kind        String
  detail      String
  estimatedUnits Float @default(0)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
}

model ProcessingMetric {
  id          String   @id @default(cuid())
  projectId   String
  stage       String
  durationMs  Int
  inputBytes  Int      @default(0)
  cacheHit    Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stage, createdAt])
}

model ProcessingJob {
  id          String   @id @default(cuid())
  projectId   String
  status      String   @default("queued")
  currentStage String  @default("UPLOAD")
  retryCount  Int      @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events      ProcessingEvent[]

  @@index([projectId, status, createdAt])
}

model ProcessingEvent {
  id          String   @id @default(cuid())
  jobId       String
  stage       String
  status      String
  detail      String
  error       String?
  retryCount  Int      @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  job         ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model RequirementRisk {
  id          String   @id @default(cuid())
  requirementId String
  score       Int
  level       String
  reasons     Json
  recommendation String
  createdAt   DateTime @default(now())
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, createdAt])
  @@index([level, score])
}

model RequirementQuality {
  id          String   @id @default(cuid())
  requirementId String
  overall     Int
  dimensions  Json
  suggestion String?
  createdAt   DateTime @default(now())
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, createdAt])
}

model AcceptanceCriteria {
  id          String   @id @default(cuid())
  requirementId String
  given       String
  when        String
  then        String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCases   TestCase[]

  @@index([requirementId, status])
}

model TestCase {
  id          String   @id @default(cuid())
  requirementId String
  acceptanceCriteriaId String?
  priority    String   @default("medium")
  preconditions String
  steps       Json
  expectedResult String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  acceptanceCriteria AcceptanceCriteria? @relation(fields: [acceptanceCriteriaId], references: [id], onDelete: SetNull)

  @@index([requirementId, status])
}

model StakeholderDecision {
  id          String   @id @default(cuid())
  projectId   String
  stakeholder String
  decision    String
  status      String   @default("open")
  requirementIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stakeholder, status])
}

model ScopeChange {
  id          String   @id @default(cuid())
  projectId   String
  fromVersion String
  toVersion   String
  added       Json
  removed     Json
  modified    Json
  expansionScore Int
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model DocumentComparison {
  id          String   @id @default(cuid())
  projectId   String
  sourceA     String
  sourceB     String
  added       Json
  removed     Json
  modified    Json
  affectedRequirementIds String[]
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model KnowledgeGraphNode {
  id          String   @id @default(cuid())
  projectId   String
  externalId  String
  type        String
  label       String
  metadata    Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoing    KnowledgeGraphEdge[] @relation("GraphFrom")
  incoming    KnowledgeGraphEdge[] @relation("GraphTo")

  @@unique([projectId, externalId])
  @@index([projectId, type])
}

model KnowledgeGraphEdge {
  id          String   @id @default(cuid())
  projectId   String
  fromNodeId  String
  toNodeId    String
  type        String
  createdAt   DateTime @default(now())
  fromNode    KnowledgeGraphNode @relation("GraphFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode      KnowledgeGraphNode @relation("GraphTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, type])
  @@index([projectId, type])
}

model Notification {
  id          String   @id @default(cuid())
  projectId   String
  kind        String
  title       String
  detail      String
  href        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, readAt, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  projectId   String
  action      String
  entity      String
  entityId    String?
  metadata    Json
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([entity, entityId])
}
