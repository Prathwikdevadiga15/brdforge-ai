# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Supabase or Neon are supported)
DATABASE_URL=
# For the docker-compose PostgreSQL service, set:
# DATABASE_URL=postgresql://brdforge:brdforge_local@localhost:5432/brdforge?schema=public

# Optional AI extraction. Without this, text files use a conservative
# keyword-based candidate extractor and are explicitly marked as heuristic.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional integrations; not required for the local demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEILI_HOST=
MEILI_MASTER_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
